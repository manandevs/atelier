# Clerk — Dashboard → API keys → Publishable key
# Without this the site still runs; the Sign In / Sign Up / account controls
# simply do not render.
VITE_CLERK_PUBLISHABLE_KEY=

# Airtable — SERVER-SIDE ONLY.
# These deliberately have NO `VITE_` prefix: anything prefixed with VITE_ is
# inlined into the client bundle and readable by every visitor. The personal
# access token can write to the base, so it must never be exposed that way.
# It is read only by api/contact.js (and by the dev-server plugin in
# vite.config.js, which loads it from .env.local).
# Airtable → Builder hub → Personal access tokens. Scopes needed:
#   data.records:write  on the "Atelier Haute Couture" base.
AIRTABLE_PAT=
AIRTABLE_BASE_ID=appHxVIvsomlNKVNS
AIRTABLE_TABLE_NAME=Enquiries
